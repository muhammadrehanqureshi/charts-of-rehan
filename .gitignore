# --- Secrets: never tracked, at any depth ---
.env
.env.*
!.env.example
*credentials*
*_token.txt
*.local.json
secrets*

# --- Local market data: the tape is never published ---
/data/
*.ndjson
*.csv.gz
*.parquet
*.sqlite
*.sqlite3
*.db
*.otf
*.ttf
*.woff
*.woff2
/data/archive/
/logs/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Web ---
web/node_modules/
web/dist/
web/.vite/

# --- OS and editors ---
Thumbs.db
.DS_Store
desktop.ini
*.lnk
.idea/
.vscode/
.freebuff/

# --- Generated at export time ---
# PROVENANCE.md is generated by the monorepo exporter and IS tracked, on
# purpose: it records the source commit and a hash per file.

# local dev-server logs (never in a commit)
web/vite.out.log
web/vite.err.log
